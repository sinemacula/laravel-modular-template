{
    $schema: "./vendor/infection/infection/resources/schema.json",
    source: {
        directories: [
            "database/factories",
            "database/seeders",
            "modules"
        ],
        excludes: [
            // Route declarations are configuration rather than logic. Mutating
            // them produces middleware and method-name variants that no
            // meaningful assertion can distinguish.
            "User/Http/routes.php"
        ]
    },
    logs: {
        summary: "build/infection-summary.log",
        text: "build/infection.log"
    },
    phpUnit: {
        configDir: ".",
        customPath: "vendor/bin/phpunit"
    },
    timeout: 15,
    mutators: {
        "@default": true,
        // Equivalent mutants. Illuminate\Routing\Controller::callAction invokes
        // the action as $this->{$method}(), from inside the class, so a
        // protected action dispatches identically to a public one. Verified by
        // making an action protected and watching the full controller suite
        // still pass. Killing these would mean reflection-asserting visibility,
        // which tests the declaration rather than the behaviour.
        PublicVisibility: {
            ignore: [
                "App\\User\\Http\\Controllers\\UserController::*"
            ]
        }
    }
}
