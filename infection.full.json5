{
    $schema: "./vendor/infection/infection/resources/schema.json",
    source: {
        directories: [
            "database/factories",
            "database/seeders",
            "modules"
        ],
        excludes: [
            // Route declarations are configuration rather than logic. Mutating
            // them produces middleware and method-name variants that no
            // meaningful assertion can distinguish.
            "User/Http/routes.php"
        ]
    },
    logs: {
        summary: "build/infection-full-summary.log",
        text: "build/infection-full.log"
    },
    phpUnit: {
        configDir: ".",
        customPath: "vendor/bin/phpunit"
    },
    timeout: 15,
    mutators: {
        "@default": true
    }
}
